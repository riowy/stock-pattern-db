# =============================================================================
# stock-pattern-db environment configuration
# Copy this file to ".env" and fill in the values you need.
# NEVER commit the real ".env" file (it is already gitignored).
# =============================================================================

# --- Required for SEC EDGAR access -----------------------------------------
# SEC requires a descriptive User-Agent with a real contact email on every
# request. See https://www.sec.gov/os/webmaster-faq#developers
# Copy this file to `.env` and replace the placeholder with your contact.
# Example (do not commit a real address):
#   SEC_USER_AGENT="StockPatternResearch contact@example.com"
# Without this value, `sync-universe` / filings in `run-daily` fail and the
# rest of the pipeline continues. `stockdb doctor` reports configured YES/NO
# and never prints the secret.
SEC_USER_AGENT="StockPatternResearch your-email@example.com"

# --- Required for FRED macro data -------------------------------------------
# Get a free API key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- License / commercial-use safety switch ---------------------------------
# Keep this "false" for personal research. If you ever turn this to "true"
# because you are running the pipeline for a commercial purpose, any data
# provider that is not marked commercial_use_safe=True will refuse to run.
COMMERCIAL_MODE=false

# --- Price data provider selection ------------------------------------------
# Swappable provider key. "yfinance" is the free research/prototyping default.
# Future values (once implemented): massive, tiingo, fmp, sharadar, ...
PRICE_PROVIDER=yfinance

# --- Resource limits (tuned conservatively for a shared 64GB / single-CPU box)
MAX_WORKERS=2
PRICE_BATCH_SIZE=25
FEATURE_BATCH_SIZE=50
MAX_FEATURE_LOOKBACK_SESSIONS=300
LABEL_RECOMPUTE_SESSIONS=30
PRICE_REQUEST_PAUSE_SECONDS=0.25
# XNYS trading sessions (not calendar days). Daily incremental overlap before
# a stale name's last stored session. Weekly repair re-fetches this many
# sessions ending at the expected latest completed session.
DAILY_PRICE_LOOKBACK_SESSIONS=3
PRICE_REPAIR_LOOKBACK_SESSIONS=20
# On-demand indicator / mining engines. v1 writes nothing; leave these false.
INDICATOR_PERSISTENCE_ENABLED=false
MINING_RESULT_PERSISTENCE_ENABLED=false
# Pattern-research registry / daily signals (independent gates; off until soak is stable).
PATTERN_REGISTRY_PERSISTENCE_ENABLED=false
DAILY_SIGNAL_PERSISTENCE_ENABLED=false
DUCKDB_THREADS=6
DUCKDB_MEMORY_LIMIT=24GB

# Windows Task Scheduler local time (HH:mm). Not a timezone -- the machine's
# local clock is used. On a Seoul box, 09:00 is well after the US close.
STOCKDB_DAILY_TIME=09:00

# --- Data directory locations (override to move data off the repo checkout) -
# All paths may be absolute or relative to the project root.
DATA_ROOT=./data
RAW_DIR=./data/raw
LAKE_DIR=./data/lake
STATE_DIR=./data/state
LOG_DIR=./data/logs

# --- SEC rate limiting (requests per second). Never set above 10. -----------
SEC_REQUESTS_PER_SECOND=3

# --- Market calendar (US equity trading sessions; NYSE by default) ----------
MARKET_CALENDAR=XNYS
# Minutes after market close before we assume today's session has
# provider EOD data available (providers often lag a bit after the close).
MARKET_DATA_GRACE_MINUTES=120

# --- Parquet partition health / compaction candidate thresholds -------------
# Monthly-partitioned datasets (prices_daily, features_daily, labels_forward_returns, filings, short_volume)
COMPACT_FILE_COUNT_THRESHOLD=25
COMPACT_AVG_FILE_SIZE_MB=8
# Yearly-partitioned datasets (volatility, corporate_actions)
COMPACT_YEARLY_FILE_COUNT_THRESHOLD=12
COMPACT_YEARLY_AVG_FILE_SIZE_MB=2

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
