# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# uv
uv.lock.tmp

# Environment secrets (only .env.example is committed).
# The repo root .gitignore has a blanket ".env*" rule that would otherwise
# also hide .env.example -- un-ignore it explicitly here.
.env
!.env.example

# Data lake / raw downloads / DuckDB state / logs are local research data,
# not source code. We ignore by file pattern (not by whole-directory
# wildcard) so the directory skeleton -- and any .gitkeep placeholder --
# stays trackable; git cannot re-include files inside a directory that was
# itself excluded by an earlier "dir/**" pattern, so we avoid that pattern.
data/raw/**/*.json
data/raw/**/*.csv
data/raw/**/*.txt
data/lake/**/*.parquet
data/state/*.duckdb
data/state/*.duckdb.wal
data/state/checkpoints/*.json
data/logs/*.log*

# OS
.DS_Store

# Local repartition/migration backups
data/lake/*_backup_*/
data/lake/*_backup_*
