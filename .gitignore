# Data lake / raw downloads / DuckDB state / logs are local research data,
# not source code. Keep the directory structure (.gitkeep) but not contents.
data/raw/**
!data/raw/**/.gitkeep
data/lake/**
!data/lake/**/.gitkeep
data/state/**
!data/state/**/.gitkeep
data/logs/**
!data/logs/**/.gitkeep

